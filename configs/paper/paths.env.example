# Locations of the data behind the paper configurations (configs/paper/*.yaml).
# Copy this file to configs/paper/paths.env (ignored by git), fill in your paths and pass it
# with --env-file, or export the variables in your shell. docs/reproducing.md lists what is
# expected under each directory.

# Datasets (h5ad files): ${INTERPRETFM_DATA}/cosmx_human_lung_sec8.h5ad, ...
INTERPRETFM_DATA=/path/to/datasets

# Activation stores: ${INTERPRETFM_STORES}/acts_extraction_<model>_<dataset>/activations/<layer>/shard_*/
INTERPRETFM_STORES=/path/to/activation_stores

# Model checkpoints: ${INTERPRETFM_MODELS}/scGPT/whole-human-pretrain/{vocab.json,...}
INTERPRETFM_MODELS=/path/to/models

# Cached intermediates of the manuscript: ${INTERPRETFM_PAPER_CACHE}/sae_v2/<dataset>/<model>/<layer>/...
# (SAE checkpoints, QC and held-out F1 tables) and the concept tables.
INTERPRETFM_PAPER_CACHE=/path/to/paper_cache

# Where the pipeline writes its run directories.
INTERPRETFM_RUNS=${INTERPRETFM_PAPER_CACHE}/pipeline_runs
