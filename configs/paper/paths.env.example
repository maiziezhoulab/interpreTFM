# Locations of the data behind the paper configurations (configs/paper/*.yaml).
# Copy this file to configs/paper/paths.env (ignored by git), fill in your paths and pass it
# with --env-file, or export the variables in your shell. docs/reproducing.md lists what is
# expected under each directory.

# Datasets (h5ad files): ${INTERPRETFM_DATA}/cosmx_human_lung_sec8.h5ad, xenium_rcc_union_filtered_nonzero.h5ad,
# plus the per-cell marker labels of the Xenium spatial analyses: ${INTERPRETFM_DATA}/xenium_marker_labels.csv.gz
INTERPRETFM_DATA=/path/to/datasets

# Activation stores: ${INTERPRETFM_STORES}/acts_extraction_<model>_<dataset>/activations/<layer>/shard_*/
INTERPRETFM_STORES=/path/to/activation_stores

# Model checkpoints: ${INTERPRETFM_MODELS}/scGPT/whole-human-pretrain/{vocab.json,...}
INTERPRETFM_MODELS=/path/to/models

# Cached intermediates of the manuscript: ${INTERPRETFM_PAPER_CACHE}/sae_v2/<dataset>/<model>/<layer>/...
# (SAE checkpoints, QC and held-out F1 tables) and the concept tables.
INTERPRETFM_PAPER_CACHE=/path/to/paper_cache

# Where the pipeline writes its run directories.
INTERPRETFM_RUNS=${INTERPRETFM_PAPER_CACHE}/pipeline_runs

# Fresh-extraction checks (configs/paper/extract_*.yaml): the conda environments that hold the
# model stacks (names from envs/*.yml; the package must be importable in them) and the Geneformer
# model folder (config.json + weights, e.g. the top level of a ctheodoris/Geneformer clone).
INTERPRETFM_SCGPT_ENV=interpretfm
INTERPRETFM_GENEFORMER_ENV=geneformer
INTERPRETFM_GENEFORMER_MODEL=/path/to/Geneformer
# C2S-Scale extraction environment (envs/c2s.yml) and model folder (a local copy of vandijklab/C2S-Scale-Gemma-2-2B).
INTERPRETFM_C2S_ENV=c2s
INTERPRETFM_C2S_MODEL=/path/to/C2S-Scale-Gemma-2-2B

# Post hoc controls: the cached run of the randomly re-initialized models (reinit_cosmx_*.yaml and the
# readout_controls_cosmx_{scgpt,geneformer}_layer2.yaml stores): ${INTERPRETFM_REINIT_CACHE}/stores/<model>/<trained|rand_table|rand_all>/,
# runs/<model>__<form>/<model>/<layer>/{sae,sae_eval,f1_heldout}/, picks/<model>__<form>.json, summary_long.csv
INTERPRETFM_REINIT_CACHE=/path/to/reinit_run
# Cached results of the post hoc readout controls, read by the reproduction tests only:
# ${INTERPRETFM_POSTHOC_CACHE}/PB-RANDTWIN/results/ and PB-NAMEPROBE/results/ (summary.csv, per_split.csv, drops.csv)
INTERPRETFM_POSTHOC_CACHE=/path/to/posthoc_results
